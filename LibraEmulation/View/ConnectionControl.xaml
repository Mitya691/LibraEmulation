<UserControl x:Class="LibraEmulation.View.ConnectionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LibraEmulation.View"
             mc:Ignorable="d" 
             d:DesignHeight="30" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="53*"/>
            <ColumnDefinition Width="145*"/>
            <ColumnDefinition Width="80*"/>
            <ColumnDefinition Width="145*"/>
            <ColumnDefinition Width="80*"/>
            <ColumnDefinition Width="145*"/>
            <ColumnDefinition Width="154*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="Порт:" VerticalAlignment="Center" Height="16"/>
        <ComboBox Grid.Column="1" Width="100" Height="20" ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding SelectedPort}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
        <TextBlock Grid.Column="2" Text="Скорость:" VerticalAlignment="Center" Margin="0,0,5,0" Height="16"/>
        <ComboBox Grid.Column="3" Width="100" ItemsSource="{Binding BaudRates}" SelectedItem="{Binding SelectedBaud}" HorizontalAlignment="Left" Margin="0,5,0,5"/>
        <TextBlock Grid.Column="4" Text="Четность:" VerticalAlignment="Center" Margin="0,0,5,0" Height="16"/>
        <ComboBox Grid.Column="5" Width="100" ItemsSource="{Binding Parities}" SelectedItem="{Binding SelectedParity}" HorizontalAlignment="Left" Margin="0,5,0,5"/>
        <Button Grid.Column="6" Width ="100" Height="20" VerticalAlignment="Center" Content="{Binding StartStopButtonText}" Command="{Binding StartStopCommand}"  Margin="0, 0, 10, 0"/>
    </Grid>
</UserControl>
